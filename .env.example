# mboss superproject — local docker compose environment.
# Copy to .env and fill in real values. .env is gitignored; this file is committed.
#
# Phase 0 scope: the compose runs postgres only, and the values below are already
# hard-coded in docker-compose.yml, so no .env is required to bring the database up.
# DATABASE_URL is documented here because mboss-database and (from task 5) the api
# service both read it.

# From inside the compose network (the api / dbos services use this form):
#   DATABASE_URL=postgres://postgres:mboss@postgres:5432/mboss
# From the host — this is the form `npx prisma migrate dev` needs in mboss-database/.env:
DATABASE_URL=postgres://postgres:mboss@localhost:5432/mboss

# Added at plan.md task 9 alongside the api / web services:
#   SECRETS_ENCRYPTION_KEY=
#   API_JWT_SECRET=
#   WEB_SERVICE_TOKEN=
#   INTERNAL_API_TOKEN=
#   SENDGRID_API_KEY=
